Subject: [PATCH] nss: allocate dummy NAPI devices on Linux 6.14 and newer

init_dummy_netdev() is private to the networking core starting with
Linux 6.14. Use alloc_netdev_dummy() on newer kernels and keep the
embedded device and original initialization on older kernels.

Allocate before firmware and memory initialization so allocation failure
can use the common probe unwind. Release the device after IRQ/NAPI
cleanup both on probe failure and driver removal.

--- a/nss_core.h
+++ b/nss_core.h
@@ -467,7 +467,11 @@ struct nss_ctx_instance {
 	struct nss_top_instance *nss_top;
 					/* Back pointer to NSS Top */
 	struct device *dev;		/* Pointer to the original device from probe */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0))
+	struct net_device *napi_ndev;   /* Dummy netdev for NAPI */
+#else
 	struct net_device napi_ndev;    /* Dummy_netdev for NAPI */
+#endif
 	uint32_t id;			/* Core ID for this instance */
 	void __iomem *nmap;		/* Pointer to NSS CSM registers */
 	void __iomem *vmap;		/* Virt mem pointer to virtual register map */
@@ -518,6 +522,15 @@ struct nss_ctx_instance {
 					/* Magic protection */
 };
 
+static inline struct net_device *nss_core_napi_netdev(struct nss_ctx_instance *nss_ctx)
+{
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0))
+	return nss_ctx->napi_ndev;
+#else
+	return &nss_ctx->napi_ndev;
+#endif
+}
+
 /*
  * NSS stats read context
  */
--- a/nss_hal/fsm9010/nss_hal_pvt.c
+++ b/nss_hal/fsm9010/nss_hal_pvt.c
@@ -291,7 +291,7 @@ static int __nss_hal_request_irq(struct
 	}
 
 	int_ctx->irq = npd->irq[irq_num];
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, nss_core_handle_napi, 64);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, nss_core_handle_napi, 64);
 	return 0;
 }
 
--- a/nss_hal/ipq50xx/nss_hal_pvt.c
+++ b/nss_hal/ipq50xx/nss_hal_pvt.c
@@ -599,7 +599,7 @@ static int __nss_hal_request_irq(struct
 		return err;
 	}
 
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, napi_poll_cb, napi_wgt);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, napi_poll_cb, napi_wgt);
 	int_ctx->cause = cause;
 	err = request_irq(irq, nss_hal_handle_irq, 0, irq_name, int_ctx);
 	if (err) {
--- a/nss_hal/ipq60xx/nss_hal_pvt.c
+++ b/nss_hal/ipq60xx/nss_hal_pvt.c
@@ -707,7 +707,7 @@ static int __nss_hal_request_irq(struct
 		return err;
 	}
 
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, napi_poll_cb, napi_wgt);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, napi_poll_cb, napi_wgt);
 	int_ctx->cause = cause;
 	err = request_irq(irq, nss_hal_handle_irq, 0, irq_name, int_ctx);
 	if (err) {
--- a/nss_hal/ipq806x/nss_hal_pvt.c
+++ b/nss_hal/ipq806x/nss_hal_pvt.c
@@ -1185,7 +1185,7 @@ static int __nss_hal_request_irq(struct
 	}
 
 	int_ctx->irq = npd->irq[irq_num];
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, nss_core_handle_napi, 64);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, nss_core_handle_napi, 64);
 
 	return 0;
 }
--- a/nss_hal/ipq807x/nss_hal_pvt.c
+++ b/nss_hal/ipq807x/nss_hal_pvt.c
@@ -751,7 +751,7 @@ static int __nss_hal_request_irq(struct
 		return err;
 	}
 
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, napi_poll_cb, napi_wgt);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, napi_poll_cb, napi_wgt);
 	int_ctx->cause = cause;
 	err = request_irq(irq, nss_hal_handle_irq, 0, irq_name, int_ctx);
 	if (err) {
--- a/nss_hal/ipq95xx/nss_hal_pvt.c
+++ b/nss_hal/ipq95xx/nss_hal_pvt.c
@@ -890,9 +890,9 @@ static int __nss_hal_request_irq(struct
 	}
 
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0))
-	netif_napi_add(&nss_ctx->napi_ndev, &int_ctx->napi, napi_poll_cb, napi_wgt);
+	netif_napi_add(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, napi_poll_cb, napi_wgt);
 #else
-	netif_napi_add_weight(&nss_ctx->napi_ndev, &int_ctx->napi, napi_poll_cb, napi_wgt);
+	netif_napi_add_weight(nss_core_napi_netdev(nss_ctx), &int_ctx->napi, napi_poll_cb, napi_wgt);
 #endif
 	int_ctx->cause = cause;
 	err = request_irq(irq, nss_hal_handle_irq, 0, irq_name, int_ctx);
--- a/nss_hal/nss_hal.c
+++ b/nss_hal/nss_hal.c
@@ -296,6 +296,15 @@ int nss_hal_probe(struct platform_device
 	 */
 	nss_ctx->dev = &nss_dev->dev;
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0))
+	nss_ctx->napi_ndev = alloc_netdev_dummy(0);
+	if (!nss_ctx->napi_ndev) {
+		nss_info_always("%px: cannot allocate NAPI netdevice\n", nss_ctx);
+		err = -ENOMEM;
+		goto err_init;
+	}
+#endif
+
 	nss_info("%px: NSS_DEV_ID %s\n", nss_ctx, dev_name(&nss_dev->dev));
 
 	/*
@@ -360,10 +369,12 @@ int nss_hal_probe(struct platform_device
 	/*
 	 * Initialize the dummy netdevice.
 	 */
-	init_dummy_netdev(&nss_ctx->napi_ndev);
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 14, 0))
+	init_dummy_netdev(nss_core_napi_netdev(nss_ctx));
+#endif
 
 	for (i = 0; i < npd->num_irq; i++) {
-		err = nss_hal_register_irq(nss_ctx, npd, &nss_ctx->napi_ndev, i);
+		err = nss_hal_register_irq(nss_ctx, npd, nss_core_napi_netdev(nss_ctx), i);
 		if (err) {
 			goto err_register_irq;
 		}
@@ -859,6 +870,12 @@ err_register_irq:
 	}
 
 err_init:
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0))
+	if (nss_ctx->napi_ndev) {
+		free_netdev(nss_ctx->napi_ndev);
+		nss_ctx->napi_ndev = NULL;
+	}
+#endif
 	if (nss_dev->dev.of_node) {
 		if (npd->nmap) {
 			iounmap(npd->nmap);
@@ -927,6 +944,13 @@ int nss_hal_remove(struct platform_devic
 		}
 	}
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0))
+	if (nss_ctx->napi_ndev) {
+		free_netdev(nss_ctx->napi_ndev);
+		nss_ctx->napi_ndev = NULL;
+	}
+#endif
+
 	nss_info("%px: All resources freed for nss core%d", nss_ctx, nss_dev->id);
 	return 0;
 }
